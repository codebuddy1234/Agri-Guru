# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment & secrets — never commit real values
.env
.env.*
!.env.example
*.pem
*.key

# ML artifacts are build outputs, reproduced by the training script.
# metadata.json is committed so the model in use is always identifiable.
backend/app/ml/**/artifacts/*.joblib
backend/app/ml/**/artifacts/*.pkl

# Processed data is derived from data/raw
data/processed/*
!data/processed/.gitkeep

# Node / Next.js
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Editors & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
