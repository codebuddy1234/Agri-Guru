# =============================================================================
# AgriGuru AI - environment configuration
#
# Copy to backend/.env and fill in real values. NEVER commit the filled file.
#   cp .env.example backend/.env
# =============================================================================

# --- Application ---
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL 13+; gen_random_uuid() is built in from 13) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agriguru
POSTGRES_PASSWORD=agriguru
POSTGRES_DB=agriguru
# Optional: set DATABASE_URL to override the values above entirely.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# --- Security ---
# REQUIRED. Minimum 32 characters. The app refuses to start if this is left
# as a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=qTpQ_RfncRInmayA4vxjQavnnjn26oGb4ulaB5ON99QAuKfUlg67-UTOPhB4ZSoc
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
# Comma-separated. Never "*" — the API sends credentials, and a wildcard with
# credentials is both rejected by browsers and a real security hole.
# localhost and 127.0.0.1 are different origins to a browser, so list both in
# development. In production, list only your real frontend domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Not used in Phase 1. Listed so it is clear where credentials will go when
# the matching module is built. Do not invent values for these.
# =============================================================================
# WEATHER_API_KEY=            # Phase 2: weather module
# SMS_PROVIDER_API_KEY=       # Phase 2: mobile OTP login
# MARKET_DATA_API_KEY=        # Phase 3: mandi price module
